{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/orchestrator/vite.config.ts",
    "dev:orchestrator": "vite --config apps/orchestrator/vite.config.ts",
    "dev:worker": "vite --config apps/worker/vite.config.ts",
    "build": "npm run build:orchestrator && npm run build:worker",
    "build:orchestrator": "vite build --config apps/orchestrator/vite.config.ts",
    "build:worker": "vite build --config apps/worker/vite.config.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
